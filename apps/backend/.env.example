# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev, PostgreSQL for prod)
# DATABASE_URL=postgresql://user:password@localhost:5432/clarity

# CORS - comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Token expiry (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ranking System Weights (sum to 1.0 for confidence score)
RANKING_WEIGHT_ACCOUNT_AGE=0.3
RANKING_WEIGHT_VERIFIED=0.2
RANKING_WEIGHT_NO_FLAGS=0.3
RANKING_WEIGHT_PROFILE_COMPLETE=0.2
RANKING_TIME_DECAY_GRAVITY=1.8
RANKING_TIME_DECAY_BASE_HOURS=2.0
RANKING_WEIGHT_UPVOTE=1.0
RANKING_WEIGHT_COMMENT=1.5
RANKING_WEIGHT_SHARE=2.0

# ---------------------------------------------------------------------------
# Cloudflare R2 — required for file upload feature (no defaults)
# ---------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_QUARANTINE_BUCKET=storytrace-quarantine
R2_PRODUCTION_BUCKET=storytrace-evidence-public
R2_CDN_DOMAIN=cdn.storytrace.org

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
